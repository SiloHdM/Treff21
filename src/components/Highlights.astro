---
import OkeyTiles from './OkeyTiles.astro';
import Icon from './Icon.astro';
// Inhalte: Angaben des Inhabers (orientalische Bar, Raucherbar, Okey, gemeinsame Zeit) + Getränkekarte.
---
<section class="section hl" aria-labelledby="hl-title">
  <span class="hl__pattern" aria-hidden="true"></span>
  <div class="container">
    <header class="hl__head">
      <p class="kicker" data-reveal>Was dich erwartet</p>
      <h2 class="h2" id="hl-title" data-reveal style="--i:1">Zusammen&shy;kommen, <em>bleiben.</em></h2>
    </header>

    <ul class="hl__grid" role="list">
      <li class="card card--okey" data-reveal>
        <div class="card__art"><OkeyTiles /></div>
        <div class="card__body">
          <p class="card__label">Spielen</p>
          <h3 class="card__title">Okey</h3>
          <p>Bei uns wird Okey gespielt. Bring deine Runde mit und nimm dir Zeit für ein paar Spiele.</p>
        </div>
      </li>
      <li class="card" data-reveal style="--i:1">
        <span class="card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2 16h15v3H2zM19 16h1.5M22 16h0M19 19h1.5"/><path d="M17.5 8.5c0-1.6 1.3-2 1.3-3.5S17.5 3 17.5 3M21 9c0-2 1.3-2.5 1.3-4.2"/></svg>
        </span>
        <p class="card__label">Raucherbar</p>
        <h3 class="card__title">Rauchen erlaubt</h3>
        <p>Treff 21 ist eine Raucherbar.</p>
        <p class="card__todo"><span class="todo">[[TODO: Hinweis Zutritt/Altersgrenze für Raucherbars (LNRSchG BW) prüfen]]</span></p>
      </li>
      <li class="card" data-reveal style="--i:2">
        <span class="card__icon card__icon--star" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M12 2.5 14.6 9.4 21.5 12 14.6 14.6 12 21.5 9.4 14.6 2.5 12 9.4 9.4Z"/><path d="M5.3 5.3 12 8 18.7 5.3 16 12 18.7 18.7 12 16 5.3 18.7 8 12Z"/></svg>
        </span>
        <p class="card__label">Orientalisch</p>
        <h3 class="card__title">Zeit gemeinsam genießen</h3>
        <p>Eine klassisch orientalische Bar: Man kommt zusammen, redet, spielt und bleibt sitzen.</p>
      </li>
      <li class="card" data-reveal style="--i:3">
        <span class="card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h14l-7 8zM12 12v7M8.5 20h7"/></svg>
        </span>
        <p class="card__label">Getränke</p>
        <h3 class="card__title">Von Tee bis Raki</h3>
        <p>Von Kaffee und Tee über Bier und Wein bis zu Cocktails und Raki. Getränke ab 2,40 €.</p>
        <a class="link-arrow" href="#karte">Zur Getränkekarte<Icon name="arrowRight" /></a>
      </li>
    </ul>
  </div>
</section>

<style>
  .hl { overflow-x: clip; }
  /* Orientalisches Sternmuster (8-zackige Sterne), sehr dezent, zur Mitte hin ausgeblendet */
  .hl__pattern {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: var(--amber); opacity: 0.07;
    -webkit-mask: url('/textures/star.svg') 0 0 / 80px 80px repeat, radial-gradient(ellipse at 50% 40%, transparent 30%, #000 85%);
    -webkit-mask-composite: source-in;
    mask: url('/textures/star.svg') 0 0 / 80px 80px repeat, radial-gradient(ellipse at 50% 40%, transparent 30%, #000 85%);
    mask-composite: intersect;
  }
  .hl__head { display: grid; gap: var(--space-4); margin-bottom: clamp(2.5rem, 6vw, 4rem); }

  .hl__grid { display: grid; gap: var(--space-4); }
  @media (min-width: 760px) {
    .hl__grid { grid-template-columns: repeat(2, 1fr); }
    .card--okey { grid-column: 1 / -1; }
  }
  @media (min-width: 1080px) {
    .hl__grid { grid-template-columns: 1.4fr 1fr 1fr; grid-template-rows: auto auto; }
    .card--okey { grid-column: 1; grid-row: 1 / 3; }
    .hl__grid > li:nth-child(4) { grid-column: 2 / 4; }
  }

  .card {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-l);
    background: linear-gradient(165deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012));
    border: 1px solid var(--line);
    color: var(--text-muted);
    transition: border-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .card:hover { border-color: rgba(245, 185, 113, 0.35); }
  .card__label { font-family: var(--font-display); font-size: 0.72rem; letter-spacing: var(--tracking-kicker); text-transform: uppercase; color: var(--amber); }
  .card__title { font-size: clamp(1.6rem, 2.6vw, 2.1rem); color: var(--text); font-weight: 400; font-variation-settings: 'opsz' 72; }
  .card__icon { width: 2.75rem; height: 2.75rem; display: grid; place-items: center; border-radius: 50%; color: var(--amber); background: rgba(245, 185, 113, 0.08); border: 1px solid rgba(245, 185, 113, 0.25); margin-bottom: var(--space-2); }
  .card__icon svg { width: 1.35rem; height: 1.35rem; }
  .card__todo { margin-top: auto; }

  .card--okey {
    justify-content: space-between;
    background:
      radial-gradient(90% 70% at 70% 0%, rgba(217, 70, 239, 0.18), transparent 60%),
      radial-gradient(80% 80% at 0% 100%, rgba(139, 92, 246, 0.22), transparent 60%),
      var(--bg-elevated);
    border-color: rgba(245, 185, 113, 0.22);
  }
  .card__art { flex: 1; display: grid; place-items: center; width: min(100%, 30rem); margin: var(--space-4) auto var(--space-6); }
  .card__body { display: grid; gap: var(--space-3); }
  .card--okey .card__title { font-size: clamp(2.6rem, 5vw, 4rem); font-weight: 350; letter-spacing: -0.02em; }
</style>
