---
// Platzhalter-Logo: Pin mit Martiniglas + Schriftzug in der Display-Serife.
// TODO: durch das Original-Logo (SVG oder transparentes PNG) ersetzen – siehe TODO.md.
// Der Handschrift-Font des Originals wird bewusst NICHT nachgebaut.
interface Props { class?: string; size?: 'sm' | 'lg' }
const { class: cls = '', size = 'sm' } = Astro.props;
---
<span class={`logo logo--${size} ${cls}`}>
  <svg class="logo__pin" viewBox="0 0 32 40" aria-hidden="true" focusable="false">
    <path d="M16 38.5c-.6 0-1.1-.3-1.5-.8C9.6 31.6 3 23.6 3 15.5a13 13 0 0 1 26 0c0 8.1-6.6 16.1-11.5 22.2-.4.5-.9.8-1.5.8z" fill="none" stroke="currentColor" stroke-width="2"/>
    <path d="M9.5 9.5h13L16 16.6zM16 16.6v5.4M12.8 22.5h6.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>
    <circle cx="20.4" cy="8" r="1.6" fill="currentColor"/>
  </svg>
  <span class="logo__text">
    <span class="logo__name">Treff 21</span>
    <span class="logo__sub">Café | Bar</span>
  </span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--text); line-height: 1; }
  .logo__pin { width: 1.4rem; height: auto; color: var(--amber); flex: none; }
  .logo__text { display: grid; gap: 0.2rem; }
  .logo__name { font-family: var(--font-display); font-size: 1.35rem; font-weight: 450; letter-spacing: -0.01em; font-variation-settings: 'opsz' 72; }
  .logo__sub { font-family: var(--font-display); font-size: 0.6rem; letter-spacing: 0.32em; text-transform: uppercase; color: var(--text-muted); }
  .logo--lg .logo__pin { width: 2.2rem; }
  .logo--lg .logo__name { font-size: 2.2rem; }
  .logo--lg .logo__sub { font-size: 0.72rem; }
</style>
