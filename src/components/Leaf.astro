---
// Freigestellte Blatt-Silhouette (eigene Zeichnung, angelehnt an die Zweige auf der Getränkekarte).
// Wird aus einer Kurve berechnet: Blätter wechselständig entlang eines geschwungenen Stiels.
interface Props { class?: string; style?: string; variant?: 'willow' | 'eucalyptus'; flip?: boolean }
const { class: cls = '', style, variant = 'willow', flip = false } = Astro.props;

const P0 = [20, 380], P1 = [120, 230], P2 = [300, 30];
const bez = (t: number) => [
  (1 - t) ** 2 * P0[0] + 2 * (1 - t) * t * P1[0] + t * t * P2[0],
  (1 - t) ** 2 * P0[1] + 2 * (1 - t) * t * P1[1] + t * t * P2[1],
];
const tan = (t: number) => {
  const dx = 2 * (1 - t) * (P1[0] - P0[0]) + 2 * t * (P2[0] - P1[0]);
  const dy = 2 * (1 - t) * (P1[1] - P0[1]) + 2 * t * (P2[1] - P1[1]);
  return (Math.atan2(dy, dx) * 180) / Math.PI;
};
const shape = variant === 'willow'
  ? 'M0 0C14-9 56-12 92 0C56 11 14 9 0 0Z'
  : 'M0 0C4-18 34-22 44 0C34 22 4 18 0 0Z';
const count = variant === 'willow' ? 9 : 11;
const leaves = Array.from({ length: count }, (_, i) => {
  const t = 0.1 + (i / (count - 1)) * 0.86;
  const [x, y] = bez(t);
  const side = i % 2 === 0 ? 1 : -1;
  const angle = tan(t) + side * (variant === 'willow' ? 38 : 62);
  const scale = (variant === 'willow' ? 1.05 : 1) - t * 0.45;
  const op = (0.62 + ((i * 37) % 30) / 100).toFixed(2);
  return { x: x.toFixed(1), y: y.toFixed(1), angle: angle.toFixed(1), scale: scale.toFixed(2), op };
});
---
<svg class={`leaf ${cls}`} style={style} viewBox="0 0 340 400" aria-hidden="true" focusable="false">
  <g fill="currentColor" transform={flip ? 'translate(340 0) scale(-1 1)' : undefined}>
    <path d={`M${P0[0]} ${P0[1]}Q${P1[0]} ${P1[1]} ${P2[0]} ${P2[1]}`} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" opacity=".7" />
    {leaves.map((l) => <path d={shape} transform={`translate(${l.x} ${l.y}) rotate(${l.angle}) scale(${l.scale})`} fill-opacity={l.op} />)}
  </g>
</svg>
