---
import { Picture, getImage } from 'astro:assets';
import t from '../i18n/de';
import Icon from './Icon.astro';
import theke from '../assets/photos/bar-theke.jpg';
import innen from '../assets/photos/innenraum-gesamt.jpg';
import bogen from '../assets/photos/bogen-eingang.jpg';
import lounge from '../assets/photos/lounge-fenster.jpg';
import deko4 from '../assets/photos/deko-04.jpg';
import deko6 from '../assets/photos/deko-06.jpg';

const photos = [
  { img: bogen, cls: 'g--wide', pos: '60% 50%', alt: 'Rundbogen zwischen den Räumen, Palmen in pinkem Licht vor einer Betonwand, dahinter ein beleuchteter Spieltisch und die Eingangstür.' },
  { img: theke, cls: 'g--tall', pos: '50% 35%', alt: 'Bartheke mit facettierter Pyramiden-Front, gleiche Kacheln an der Decke, Edison-Glühbirnen und ein beleuchtetes Flaschenregal.' },
  { img: deko4, cls: 'g--small', pos: '50% 50%', alt: 'Detail: Eukalyptus und Palmwedel an einem schwarzen Gitter unter der Decke.' },
  { img: innen, cls: 'g--tall', pos: '50% 40%', alt: 'Blick über die Theke zum Rundbogen, darüber hängende Pflanzen an der Decke, im hinteren Raum ein Fernseher mit Logo.' },
  { img: lounge, cls: 'g--wide', pos: '50% 60%', alt: 'Sitzbereich mit großen Fenstern, Betonwand, Pendelleuchten, Pflanzengitter an der Decke und Fun4Four-Spieltisch.' },
  { img: deko6, cls: 'g--small', pos: '50% 50%', alt: 'Detail: Palmwedel und Pflanzen an einem Gitter, im Hintergrund eine Pendelleuchte.' },
];
// große Version für die Lightbox
const full = await Promise.all(photos.map((p) => getImage({ src: p.img, format: 'webp', width: Math.min(p.img.width, 1920), quality: 82 })));
---
<section class="section gallery" id="galerie" aria-labelledby="gallery-title">
  <div class="container">
    <header class="gallery__head">
      <p class="kicker" data-reveal>{t.gallery.kicker}</p>
      <h2 class="h2" id="gallery-title" data-reveal style="--i:1">{t.gallery.title}</h2>
    </header>

    <ul class="grid" role="list">
      {photos.map((p, i) => (
        <li class:list={['g', p.cls]} data-reveal style={`--i:${i % 3}`}>
          <button type="button" class="g__btn" data-lightbox-open={i} data-full={full[i].src} data-alt={p.alt}>
            <Picture src={p.img} formats={['avif', 'webp']} fallbackFormat="jpg"
              widths={[640, 1280, 1920].filter((w) => w <= p.img.width).concat(p.img.width < 640 ? [p.img.width] : [])}
              sizes={p.cls === 'g--wide' ? '(min-width: 900px) 58vw, 100vw' : '(min-width: 900px) 30vw, 50vw'}
              quality={76} alt={p.alt} loading="lazy" style={`object-position:${p.pos}`} />
            <span class="g__zoom" aria-hidden="true"><Icon name="expand" /></span>
            <span class="sr-only">{t.gallery.open}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Bildansicht">
    <figure class="lightbox__fig">
      <img class="lightbox__img" alt="" data-lightbox-img />
      <figcaption class="lightbox__cap"><span data-lightbox-count></span><span data-lightbox-cap></span></figcaption>
    </figure>
    <button class="lb-btn lb-btn--close" type="button" data-lightbox-close><Icon name="close" /><span class="sr-only">{t.gallery.close}</span></button>
    <button class="lb-btn lb-btn--prev" type="button" data-lightbox-prev><Icon name="chevronLeft" /><span class="sr-only">{t.gallery.prev}</span></button>
    <button class="lb-btn lb-btn--next" type="button" data-lightbox-next><Icon name="chevronRight" /><span class="sr-only">{t.gallery.next}</span></button>
  </dialog>
</section>

<style>
  .gallery__head { display: grid; gap: var(--space-4); margin-bottom: clamp(2.5rem, 6vw, 4.5rem); }

  /* Bento-Raster: Hoch- und Querformate gemischt */
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); grid-auto-rows: clamp(6.5rem, 26vw, 10rem); gap: var(--space-3); }
  .g:nth-child(1) { grid-column: 1 / 3; grid-row: 1 / 3; }
  .g:nth-child(2) { grid-column: 1; grid-row: 3 / 6; }
  .g:nth-child(3) { grid-column: 2; grid-row: 3 / 5; }
  .g:nth-child(4) { grid-column: 2; grid-row: 5 / 8; }
  .g:nth-child(5) { grid-column: 1 / 3; grid-row: 8 / 10; }
  .g:nth-child(6) { grid-column: 1; grid-row: 6 / 8; }
  @media (min-width: 900px) {
    .grid { grid-template-columns: repeat(12, 1fr); grid-auto-rows: 7.5vw; gap: var(--space-4); }
    .g:nth-child(1) { grid-column: 1 / 8; grid-row: 1 / 5; }
    .g:nth-child(2) { grid-column: 8 / 13; grid-row: 1 / 7; }
    .g:nth-child(3) { grid-column: 1 / 4; grid-row: 5 / 8; }
    .g:nth-child(4) { grid-column: 4 / 8; grid-row: 5 / 10; }
    .g:nth-child(5) { grid-column: 8 / 13; grid-row: 7 / 10; }
    .g:nth-child(6) { grid-column: 1 / 4; grid-row: 8 / 10; }
  }
  @media (min-width: 1500px) { .grid { grid-auto-rows: 7rem; } }

  .g { position: relative; border-radius: var(--radius-m); overflow: hidden; background: var(--surface); }
  .g__btn { position: absolute; inset: 0; width: 100%; height: 100%; cursor: zoom-in; }
  .g__btn:focus-visible { outline-offset: -3px; border-radius: var(--radius-m); }
  .g :global(picture) { position: absolute; inset: 0; }
  .g :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out), filter 600ms var(--ease-out); filter: saturate(0.92); }
  .g:hover :global(img) { transform: scale(1.04); filter: saturate(1.05); }
  .g__zoom {
    position: absolute; right: 0.75rem; bottom: 0.75rem;
    width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(11, 10, 16, 0.6); color: var(--text); border: 1px solid var(--line-strong);
    opacity: 0; transform: translateY(6px); transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .g__zoom :global(svg) { width: 16px; height: 16px; }
  .g:hover .g__zoom, .g__btn:focus-visible .g__zoom { opacity: 1; transform: none; }
  @media (hover: none) { .g__zoom { opacity: 1; transform: none; } }

  /* Lightbox */
  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: rgba(8, 7, 12, 0.96); color: var(--text);
    overscroll-behavior: contain;
  }
  .lightbox::backdrop { background: rgba(8, 7, 12, 0.8); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox__fig { display: grid; gap: var(--space-3); justify-items: center; padding: 4.5rem var(--gutter) 2rem; width: 100%; height: 100%; align-content: center; touch-action: pan-y; }
  .lightbox__img { max-width: min(100%, 1400px); max-height: calc(100dvh - 9rem); width: auto; height: auto; object-fit: contain; border-radius: var(--radius-s); user-select: none; -webkit-user-drag: none; }
  .lightbox__cap { display: flex; gap: var(--space-4); max-width: 60ch; font-size: var(--fs-small); color: var(--text-muted); text-align: left; }
  .lightbox__cap span:first-child { color: var(--amber); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .lb-btn {
    position: absolute; width: 48px; height: 48px; border-radius: 50%;
    display: grid; place-items: center; color: var(--text);
    background: rgba(30, 26, 39, 0.8); border: 1px solid var(--line-strong);
    transition: border-color var(--dur-fast), color var(--dur-fast);
  }
  .lb-btn:hover { color: var(--amber); border-color: var(--amber); }
  .lb-btn :global(svg) { width: 22px; height: 22px; }
  .lb-btn--close { top: max(1rem, env(safe-area-inset-top)); right: var(--gutter); }
  .lb-btn--prev, .lb-btn--next { top: 50%; translate: 0 -50%; }
  .lb-btn--prev { left: var(--gutter); }
  .lb-btn--next { right: var(--gutter); }
  @media (max-width: 699px) {
    .lb-btn--prev, .lb-btn--next { top: auto; bottom: max(1rem, env(safe-area-inset-bottom)); translate: none; }
    .lightbox__fig { padding-bottom: 5.5rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] .lightbox__img { animation: lb-in 380ms var(--ease-out); }
  }
  @keyframes lb-in { from { opacity: 0; transform: scale(0.97); } }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = dlg.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
  const cap = dlg.querySelector('[data-lightbox-cap]')!;
  const count = dlg.querySelector('[data-lightbox-count]')!;
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]')];
  let idx = 0;
  let opener: HTMLElement | null = null;

  const show = (i: number) => {
    idx = (i + triggers.length) % triggers.length;
    const t = triggers[idx];
    img.src = t.dataset.full!;
    img.alt = t.dataset.alt!;
    cap.textContent = t.dataset.alt!;
    count.textContent = `${String(idx + 1).padStart(2, '0')} / ${String(triggers.length).padStart(2, '0')}`;
    // Restart der Einblend-Animation
    img.style.animation = 'none'; void img.offsetWidth; img.style.animation = '';
  };
  triggers.forEach((t, i) => t.addEventListener('click', () => {
    opener = t; show(i); dlg.showModal(); document.documentElement.style.overflow = 'hidden';
  }));
  dlg.addEventListener('close', () => { document.documentElement.style.overflow = ''; opener?.focus(); });
  dlg.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dlg.close());
  dlg.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(idx - 1));
  dlg.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(idx + 1));
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); show(idx - 1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); show(idx + 1); }
  });
  // Klick auf den dunklen Hintergrund schließt
  dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).classList.contains('lightbox__fig')) dlg.close(); });

  // Swipe auf Mobile
  let x0: number | null = null, y0 = 0;
  dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
  dlg.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(idx + (dx < 0 ? 1 : -1));
    x0 = null;
  });
</script>
