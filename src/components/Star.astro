---
interface Props { class?: string; fill?: number }
const { class: cls, fill = 1 } = Astro.props;
const id = `s${Math.random().toString(36).slice(2, 8)}`;
---
<svg class={cls} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <defs><linearGradient id={id}><stop offset={fill} stop-color="currentColor"/><stop offset={fill} stop-color="currentColor" stop-opacity=".22"/></linearGradient></defs>
  <path fill={`url(#${id})`} d="M12 2.6l2.9 6 6.6.8-4.9 4.6 1.3 6.5L12 17.3l-5.9 3.2 1.3-6.5L2.5 9.4l6.6-.8z"/>
</svg>
